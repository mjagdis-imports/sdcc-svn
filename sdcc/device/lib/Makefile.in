	fi

model-s08-stack-auto:
	if grep '^hc08$$' $(top_builddir)/ports.build > /dev/null; then \
	  $(MAKE) MODELFLAGS="-ms08 --stack-auto" PORT=s08-stack-auto objects || exit 1; \
	fi

model-mos6502:
	if grep '^mos6502$$' $(top_builddir)/ports.build > /dev/null; then \
	  $(MAKE) MODELFLAGS="-mmos6502" PORT=mos6502 objects || exit 1; \
	fi

