	if grep '^mos6502$$' $(top_builddir)/ports.build > /dev/null; then \
	  $(MAKE) MODELFLAGS="-mmos6502 --stack-auto" PORT=mos6502-stack-auto objects || exit 1; \
	fi

model-mos65c02:
	if grep '^mos6502$$' $(top_builddir)/ports.build > /dev/null; then \
