	if grep '^z80$$' $(top_builddir)/ports.build > /dev/null; then \
	  $(MAKE) MODELFLAGS="-mr800" PORT=r800 objects OEXT=.o || exit 1; \
	fi

model-hc08:
	if grep '^hc08$$' $(top_builddir)/ports.build > /dev/null; then \
	  $(MAKE) MODELFLAGS="-mhc08" PORT=hc08 objects || exit 1; \
	fi

model-s08:
	if grep '^hc08$$' $(top_builddir)/ports.build > /dev/null; then \
