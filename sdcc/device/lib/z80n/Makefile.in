# libc/z80n Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../z80-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasz80
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	= crt0.rel
LIB_TYPE	= @LIB_TYPE@
LIB		= z80n.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  crtenter \
  divmixed \
  divsigned \
  divunsigned \
  modmixed \
  modsigned \
  modunsigned \
  mul \
  mulchar \
  __sdcc_bcall \
  __sdcc_call_hl \
  __sdcc_call_iy \
  _startup \
  __strreverse \
  __uitobcd \
  __ultobcd

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  $(COMMON_LIBC_STRUCT_RET) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  heap \
  __itoa \
  __ltoa \
  setjmp

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

