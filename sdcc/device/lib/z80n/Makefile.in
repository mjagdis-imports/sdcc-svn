# libc/z80n Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

VPATH  = $(srcdir):$(srcdir)/../z80-common
INCDIR          = $(top_srcdir)/device/include
PORTINCDIR      = $(INCDIR)/$(PORT)

LIB_TYPE     = @LIB_TYPE@
LIB = z80n.lib

AS = $(top_builddir)/bin/sdasz80

ASFLAGS = -plosgff -I$(srcdir)
CFLAGS = -I$(INCDIR) -I$(PORTINCDIR) -I. --std-c23
EXTRA_CFLAGS = $(MODELFLAGS) --max-allocs-per-node 25000

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/$(PORT)

include $(srcdir)/../incl.mk

PORT_FLOAT = $(COMMON_FLOAT)

PORT_INT = $(COMMON_INT)

PORT_LONG = $(COMMON_LONG) \
  _divulong.c \
  _mullong.c

PORT_LONGLONG = $(COMMON_LONGLONG) \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

PORT_SDCC = $(COMMON_SDCC) \
  _startup.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c \
  strnlen.c \
  _strcmp.c \
  atomic_flag_clear.c

OBJ = divunsigned.rel divsigned.rel divmixed.rel modunsigned.rel modsigned.rel modmixed.rel mul.rel mulchar.rel \
      heap.rel memmove.rel strcpy.rel strlen.rel abs.rel __sdcc_call_hl.rel __sdcc_call_iy.rel crtenter.rel \
      setjmp.rel atomic_flag_test_and_set.rel memcpy.rel __strreverse.rel __uitobcd.rel __ultobcd.rel __itoa.rel \
      __ltoa.rel __sdcc_bcall.rel

PORT_SOURCES = $(addprefix ../,$(PORT_FLOAT) $(PORT_INT) $(PORT_LONG) $(PORT_LONGLONG) $(PORT_SDCC))
PORT_OBJECTS = $(patsubst %.c,%.rel,$(PORT_FLOAT) $(PORT_INT) $(PORT_LONG) $(PORT_LONGLONG) $(PORT_SDCC))

all: $(PORTDIR)/$(LIB) $(PORTDIR)/crt0.rel

$(PORTDIR)/crt0.rel: crt0.rel
	cp crt0.rel $(PORTDIR)/crt0.rel

$(PORTDIR)/$(LIB): $(OBJ) $(PORT_OBJECTS) Makefile
	rm -f $@
ifeq ($(LIB_TYPE), SDCCLIB)
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(PORT_OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(PORT_OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(PORT_OBJECTS)
    else
	for i in $(basename $(OBJ) $(PORT_OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(PORT_OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(PORT)/Makefile

