# libc/mcs51-small Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../mcs51-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdas8051
EXTRA_CFLAGS	= -I$(INCDIR)/mcs51 --opt-code-speed
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= mcs51.lib


PORT_SDCC = $(COMMON_SDCC) \
  _divsint \
  _divuint \
  _modsint \
  _moduint \
  _mulint \
  _srulonglong \
  _srslonglong \
  _slulonglong \
  _slslonglong \
  _mullonglong \
  _divslonglong \
  _divulonglong \
  _modslonglong \
  _modulonglong \
  crtstart \
  crtxinit \
  crtxclear \
  crtclear \
  crtpagesfr \
  crtbank \
  crtcall \
  crtxstack \
  crtxpush \
  crtxpop \
  gptr_cmp

PORT_FLOAT = $(COMMON_FLOAT) \
  _fscmp \
  _fsget1arg \
  _fsget2args \
  _fsnormalize \
  _fsreturnval \
  _fsrshift \
  _fsswapargs \
  _logexpf

PORT_LIBC = $(COMMON_LIBC) \
  _autobaud \
  bp \
  bpx \
  _decdptr \
  _gptrget \
  _gptrgetc \
  _gptrput \
  _ser \
  setjmp \
  serial \
  __itoa \
  __ltoa \
  __memcpy \
  _heap \
  _spx \
  _startup \
  div \
  ldiv \
  lldiv \
  imaxdiv \
  vprintf \
  printf_fast \
  printf_fast_f \
  printf_tiny \
  printfl \
  atomic_flag_clear \
  sdcc_atomic_maybe_rollback

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

