# libc/s08 Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(std_lib_dirs)
AS		= $(top_builddir)/bin/sdas6808
EXTRA_CFLAGS	= --max-allocs-per-node 25000 --opt-code-speed
PORT_CRT	= 
LIB_TYPE	= @LIB_TYPE@
LIB		= s08.lib


PORT_SDCC = $(COMMON_SDCC) \
  _divsint \
  _divslonglong \
  _divuint \
  _divulonglong \
  _modsint \
  _modslonglong \
  _moduint \
  _modulonglong \
  _mulint \
  _mullonglong \
  _ret \
  _srulonglong \
  _srslonglong \
  _slulonglong \
  _slslonglong \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  __itoa \
  __ltoa \
  __memcpy \
  _heap \
  setjmp \
  div \
  ldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

