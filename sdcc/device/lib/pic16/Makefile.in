# libc/pic16 Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir):$(srcdir)/..:$(std_lib_dirs)
AS		= /usr/bin/gpasm
EXTRA_CFLAGS	= --opt-code-speed --use-non-free -I$(top_srcdir)/device/non-free/include/pic16
PORT_CRT	= crt0iz.o
LIB_TYPE	= @LIB_TYPE@
LIB		= pic16.lib
#/usr/bin/gplink
SDAR		= /usr/bin/gplib

ASFLAGS = -DHAVE_CONFIG -I$(srcdir) -I$(INCDIR)/pic16 \
	-I$(top_srcdir)/device/non-free/include/pic16 
#-p18f1718

PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  gptrget1 \
  gptrget2 \
  gptrget3 \
  gptrget4 \
  gptrput1 \
  gptrput2 \
  gptrput3 \
  gptrput4 \
  eeprom16_gptrget1 \
  eeprom16_gptrget2 \
  eeprom16_gptrget3 \
  eeprom16_gptrget4 \
  eeprom16_gptrput1 \
  eeprom16_gptrput2 \
  eeprom16_gptrput3 \
  eeprom16_gptrput4 \
  eeprom8_gptrget1 \
  eeprom8_gptrget2 \
  eeprom8_gptrget3 \
  eeprom8_gptrget4 \
  eeprom8_gptrput1 \
  eeprom8_gptrput2 \
  eeprom8_gptrput3 \
  eeprom8_gptrput4 \
  eeprom16_write \
  eeprom8_write \
  gptrload \
  _mulschar \
  _muluchar

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = \
  abs \
  aligned_alloc \
  __assert \
  atoi \
  atol \
  atoll \
  bsearch \
  btowc \
  c16rtomb \
  c16stombs \
  c32rtomb \
  calloc \
  call_once \
  ckd_add \
  ckd_mul \
  ckd_sub \
  div \
  errno \
  free \
  gets \
  imaxabs \
  isalnum \
  isalpha \
  isblank \
  iscntrl \
  isdigit \
  isgraph \
  islower \
  isprint \
  ispunct \
  isspace \
  isupper \
  isxdigit \
  __itoa \
  __ltoa \
  labs \
  ldiv \
  llabs \
  lldiv \
  ltoa \
  malloc \
  mblen \
  mbrlen \
  mbrtoc16 \
  mbrtoc32 \
  mbrtowc \
  mbsinit \
  mbstoc16s \
  mbstowcs \
  mbtowc \
  memalignment \
  memccpy \
  memchr \
  memcmp \
  memcpy \
  memmove \
  memset \
  memset_explicit \
  printf \
  puts \
  qsort \
  rand \
  realloc \
  setjmp \
  sprintf \
  __stdc_bit_ceilull \
  __stdc_bit_width \
  __stdc_count_ones \
  __stdc_first_leading_one \
  __stdc_first_trailing_one \
  __stdc_leading_zeros \
  stdc_load8 \
  stdc_memreverse8 \
  stdc_memreverse8u \
  stdc_store8 \
  __stdc_trailing_ones \
  strcat \
  strchr \
  strcmp \
  strcpy \
  strcspn \
  strdup \
  strlen \
  strncat \
  strncmp \
  strncpy \
  strndup \
  strnlen \
  strpbrk \
  strrchr \
  strsep \
  strspn \
  strstr \
  strtoimax \
  strtok \
  strtol \
  strtoll \
  strtoul \
  strtoull \
  strtoumax \
  strxfrm \
  strmgpsim \
  strmmssp \
  strmusart \
  strmputchar \
  streams \
  uabs \
  ulabs \
  ullabs \
  umaxabs \
  vfprintf \
  vprintf \
  wcrtomb \
  wcscmp \
  wcslen \
  wcsncmp \
  wcsnlen \
  wcstoimax \
  wcstol \
  wcstoll \
  wcstombs \
  wcstoul \
  wcstoull \
  wcstoumax \
  wctob \
  wctomb

PORT_LIBM = $(COMMON_LIBM)

#include $(srcdir)/../library_build.mk

PORT_OBJECTS = $(addsuffix .o, $(PORT_SDCC) $(PORT_FLOAT) $(PORT_LIBC) $(PORT_LIBM) )

all: $(PORTDIR)/$(LIB) $(PORTDIR)/$(PORT_CRT)

$(PORTDIR)/$(PORT_CRT): $(PORT_CRT)
	cp $(PORT_CRT) $(PORTDIR)/$(PORT_CRT)

$(PORTDIR)/$(LIB): $(PORT_OBJECTS) Makefile
	$(SDAR) -c $(PORTDIR)/libsdcc.lib $(addsuffix .o, $(PORT_SDCC) ) \
	  $(addsuffix .o, $(PORT_FLOAT) )
	$(SDAR) -c $(PORTDIR)/libc.lib $(addsuffix .o, $(PORT_LIBC) )
	$(SDAR) -c $(PORTDIR)/libm.lib $(addsuffix .o, $(PORT_LIBM) )

clean:
	rm -f *.o *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(PORT)/Makefile

%.o: %.s
	$(AS) $(ASFLAGS) -c -o $@ $<

%.o: %.c
	$(CC) $(CFLAGS) ${CPPFLAGS} ${EXTRA_CFLAGS} -c $< -o $@

