# libc/f8l Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../mos-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasf8
EXTRA_CFLAGS	= --max-allocs-per-node 25000 --opt-code-speed
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= f8l.lib


PORT_SDCC = $(COMMON_SDCC) \
  _muluchar \
  _divschar \
  _divsint \
  _divslonglong \
  _divuchar \
  _divuint \
  _divulong \
  _divulonglong \
  _modschar \
  _modsint \
  _modslonglong \
  _moduchar \
  _moduint \
  _modulonglong \
  _mulint \
  _mullong \
  _mullonglong \
  _mulschar \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  __itoa \
  __ltoa \
  heap \
  setjmp \
  __memcpy \
  div \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

