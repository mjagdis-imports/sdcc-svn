# libc/sm83 Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasgb
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	= crt0.rel
LIB_TYPE	= @LIB_TYPE@
LIB		= sm83.lib


PORT_SDCC = $(COMMON_SDCC) \
  __sdcc_call_hl \
  divint \
  _divslonglong \
  _divulonglong \
  __initrleblock \
  _modslonglong \
  _modulonglong \
  mul \
  _mullonglong

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  heap \
  __itoa \
  __ltoa \
  setjmp \
  _startup \
  div \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

