# libc/r6k Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH		= $(srcdir)/../rabbit-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasrab
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	= crt0.rel
LIB_TYPE	= @LIB_TYPE@
LIB		= r6k.lib


PORT_SDCC = $(COMMON_SDCC) \
  crtenter \
  divmixed \
  divsigned \
  _divslonglong \
  _divulong \
  _divulonglong \
  divunsigned \
  modmixed \
  modsigned \
  _modslonglong \
  _modulonglong \
  modunsigned \
  mulchar \
  _mullong \
  _mullonglong \
  __sdcc_call_hl \
  __sdcc_call_iy \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set  \
  heap \
  __itoa \
  __ltoa \
  setjmp \
  div \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

