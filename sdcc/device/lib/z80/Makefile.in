# libc/z80 Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

VPATH		= $(srcdir):$(srcdir)/../z80-common
INCDIR          = $(top_srcdir)/device/include
PORTINCDIR      = $(INCDIR)/$(PORT)

LIB_TYPE	= @LIB_TYPE@
LIB		= z80.lib

AS = $(top_builddir)/bin/sdasz80

ASFLAGS = -plosgff -I$(srcdir)
CFLAGS = -I$(INCDIR) -I$(PORTINCDIR) -I. --std-c23
EXTRA_CFLAGS = $(MODELFLAGS) --max-allocs-per-node 25000

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/$(PORT)

include $(srcdir)/../incl.mk

PORT_EXTRA = \
  __sdcc_call_hl.rel \
  __sdcc_call_iy.rel \
  crtenter.rel \
  __uitobcd.rel \
  __ultobcd.rel \
  __strreverse.rel \
  __sdcc_bcall.rel \
  __sdcc_critical.rel

PORT_SDCC = $(PORT_EXTRA) $(COMMON_SDCC) \
  __itoa.c \
  __ltoa.c \
  heap.c \
  _startup.c \
  divunsigned.c \
  divsigned.c \
  divmixed.c \
  modunsigned.c \
  modsigned.c \
  modmixed.c \
  mul.c \
  mulchar.c \
  __muluint2ulong.c \
  __mulsint2slong.c \
  _divulong.c \
  _mullong.c
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  strlen.c \
  strnlen.c \
  vprintf.c \
  memcpy.c \
  atomic_flag_clear.c \
  atomic_flag_test_and_set.c \
  setjmp.c

PORT_LIBM = $(COMMON_LIBM)

PORT_SOURCES = $(addprefix ../,$(PORT_SDCC) $(PORT_FLOAT) $(PORT_LIBC) $(PORT_LIBM) )
PORT_OBJECTS = $(patsubst %.c,%.rel,$(PORT_SDCC) $(PORT_FLOAT) $(PORT_LIBC) $(PORT_LIBM) )

all: $(PORTDIR)/$(LIB) $(PORTDIR)/crt0.rel

$(PORTDIR)/crt0.rel: crt0.rel
	cp crt0.rel $(PORTDIR)/crt0.rel

$(PORTDIR)/$(LIB): $(PORT_OBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(PORT_OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(PORT_OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(PORT_OBJECTS)
    else
	for i in $(basename $(OBJ) $(PORT_OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(PORT_OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(PORT)/Makefile

