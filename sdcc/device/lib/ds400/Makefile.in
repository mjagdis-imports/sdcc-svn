# libc/ds400 Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

VPATH  		= $(srcdir):$(srcdir)/../mcs51-common
INCDIR          = $(top_srcdir)/device/include
PORTINCDIR      = $(INCDIR)/$(PORT)

LIB_TYPE	= @LIB_TYPE@
LIB		= ds400.lib

AS = $(top_builddir)/bin/sdas8051

#CPPFLAGS = -I$(srcdir)/../../include
ASFLAGS = -plosgff -I$(srcdir)
CFLAGS = -I$(INCDIR) -I$(PORTINCDIR) -I$(INCDIR)/mcs51 -I. --std-c23
EXTRA_CFLAGS = $(MODELFLAGS) --opt-code-speed

# override PORTDIR defined by super (parent) makefile
override PORTDIR = ../build/$(PORT)

#VERBOSE = --verbose

include $(srcdir)/../incl.mk

PORT_FLOAT = $(COMMON_FLOAT)

PORT_INT = $(COMMON_INT) \
  _divsint.c \
  _divuint.c \
  _modsint.c \
  _moduint.c \
  _mulint.c

PORT_LONG = $(COMMON_LONG) \
  _divulong.c \
  _mullong.c

PORT_LONGLONG = $(COMMON_LONGLONG) \
  _srulonglong.c \
  _srslonglong.c \
  _slulonglong.c \
  _slslonglong.c \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

PORT_SDCC = $(COMMON_SDCC) \
  _autobaud.c \
  _bp.c \
  _bpx.c \
  _decdptr.c \
  _gptrget.c \
  _gptrgetc.c \
  _gptrput.c \
  _ser.c \
  setjmp.c \
  serial.c \
  __itoa.c \
  __ltoa.c \
  _spx.c \
  _startup.c \
  strlen.c \
  strnlen.c \
  __memcpy.c \
  memcpy.c \
  _heap.c \
  div.c \
  ldiv.c \
  lldiv.c \
  imaxdiv.c \
  sprintf.c \
  vprintf.c \
  printf_fast.c \
  printf_fast_f.c \
  printf_tiny.c \
  printfl.c

OBJ = tinibios.rel memcpyx.rel ds400rom.rel

PORT_SOURCES = $(addprefix ../,$(PORT_FLOAT) $(PORT_INT) $(PORT_LONG) $(PORT_LONGLONG) $(PORT_SDCC))
PORT_OBJECTS = $(patsubst %.c,%.rel,$(PORT_FLOAT) $(PORT_INT) $(PORT_LONG) $(PORT_LONGLONG) $(PORT_SDCC))

all: $(PORTDIR)/$(LIB)

$(PORTDIR)/$(LIB): $(OBJ) $(PORT_OBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(PORT_OBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(PORT_OBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(PORT_OBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(PORT_OBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(PORT_OBJECTS) $(PORTDIR)
    endif
  endif
endif

clean:
	rm -f *.lst *.rel *.sym *.cdb *.asm \#* *~ *.rst *.hex
	rm -f *.ihx temp.lnk *.map *.lib

distclean: clean
	rm -f Makefile

Makefile: $(srcdir)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(PORT)/Makefile

