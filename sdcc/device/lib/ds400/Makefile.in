# libc/ds400 Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../mcs51-common:$(std_lib_dirs)
AS = $(top_builddir)/bin/sdas390
EXTRA_CFLAGS	= -I$(INCDIR)/mcs51 --opt-code-speed
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= ds400.lib


PORT_SDCC = $(COMMON_SDCC) \
  bp \
  bpx \
  _decdptr \
  _divsint \
  _divslonglong \
  _divuint \
  _divulonglong \
  gptr_cmp \
  _gptrget \
  _gptrgetc \
  _gptrput \
  _modsint \
  _modslonglong \
  _moduint \
  _modulonglong \
  _mulint \
  _mullonglong \
  _slslonglong \
  _slulonglong \
  _spx \
  _srslonglong \
  _srulonglong \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  div \
  _heap \
  imaxdiv \
  __itoa \
  ldiv \
  lldiv \
  __ltoa \
  __memcpy \
  printf_fast \
  printf_fast_f \
  printfl \
  printf_tiny \
  setjmp \
  memcpyx \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

