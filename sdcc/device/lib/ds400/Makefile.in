# libc/ds400 Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../mcs51-common:$(std_lib_dirs)
AS = $(top_builddir)/bin/sdas390
EXTRA_CFLAGS	= -I$(INCDIR)/mcs51 --opt-code-speed
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= ds400.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  bp \
  bpx \
  _decdptr \
  _divsint \
  _divuint \
  gptr_cmp \
  _gptrget \
  _gptrgetc \
  _gptrput \
  _modsint \
  _moduint \
  _mulint \
  _spx \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  $(COMMON_LIBC_STRUCT_RET) \
  __memcpy \
  printf_fast \
  printf_fast_f \
  printfl \
  printf_tiny \
  memcpyx \
  tinibios

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

