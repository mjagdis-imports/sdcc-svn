# libc/pdk13 Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH		= $(srcdir)/../pdk-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdaspdk13
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= pdk13.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  _divschar \
  _divsint \
  _divuchar \
  _divuint \
  __gptrget \
  __gptrget2 \
  _modschar \
  _modsint \
  _moduchar \
  _moduint \
  _mulint \
  _mulschar \
  _muluchar \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  $(COMMON_LIBC_STRUCT_RET) \
  heap \
  __itoa \
  __memcpy \
  __setjmp

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

