# libc/mcs51-large-stack-auto Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir):$(srcdir)/../mcs51-common/asmfloat:$(srcdir)/../mcs51-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdas8051
EXTRA_CFLAGS	= -I$(INCDIR)/mcs51 --opt-code-speed
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB 		= mcs51.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  bp \
  bpx \
  crtbank \
  crtcall \
  crtclear \
  crtpagesfr \
  crtstart \
  crtxclear \
  crtxinit \
  crtxpop \
  crtxpush \
  crtxstack \
  _decdptr \
  gptr_cmp \
  _gptrget \
  _gptrgetc \
  _gptrput \
  _spx \
  _startup

PORT_FLOAT = $(COMMON_FLOAT) \
  _fscmp \
  _fsget1arg \
  _fsget2args \
  _fsnormalize \
  _fsreturnval \
  _fsrshift \
  _fsswapargs \
  _logexpf

PORT_LIBC = $(COMMON_LIBC) \
  $(COMMON_LIBC_STRUCT_RET) \
  atomic_flag_clear \
  __memcpy \
  printf_fast \
  printf_fast_f \
  printfl \
  printf_tiny \
  sdcc_atomic_maybe_rollback

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

