# libc/mos65c02 Makefile

srcdir		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../mos-common:$(std_lib_dirs)
AS 		= $(top_builddir)/bin/sdas6500
EXTRA_CFLAGS 	= --max-allocs-per-node 25000 --opt-code-speed
PORT_CRT	= crt0.rel
LIB_TYPE	= @LIB_TYPE@
LIB		= mos65c02.lib


PORT_SDCC = $(COMMON_SDCC) \
  _divschar \
  _divsint \
  _divuchar \
  _divuint \
  _moduchar \
  _modschar \
  _moduint \
  _modsint \
  _mulint \
  _muluchar \
  _mulschar \
  _mullonglong \
  _divslonglong \
  _divulonglong \
  _modslonglong \
  _modulonglong \
  __sdcc_regs \
  __sdcc_indirect_jsr

PORT_FLOAT = $(COMMON_FLOAT) \
  _floatlib

PORT_LIBC = $(COMMON_LIBC) \
  __itoa \
  __ltoa \
  _heap \
  _startup \
  setjmp \
  div \
  ldiv \
  lldiv \
  vprintf \
  atomic_flag_clear \
  atomic_flag_test_and_set

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

