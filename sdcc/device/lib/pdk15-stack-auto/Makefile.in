# libc/pdk15 Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH		= $(srcdir)/../pdk-common:$(std_lib_dirs)
AS		= $(top_builddir)/bin/sdaspdk15
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB		= pdk15.lib


PORT_SDCC = $(COMMON_SDCC) \
  _divschar \
  _divsint \
  _divslonglong \
  _divuchar \
  _divuint \
  _divulonglong \
  __gptrget \
  __gptrget2 \
  _modschar \
  _modsint \
  _modslonglong \
  _moduchar \
  _moduint \
  _modulonglong \
  _mulint \
  _mullonglong \
  _mulschar \
  _muluchar \
  _slslonglong \
  _slulonglong \
  _srslonglong \
  _srulonglong \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  heap \
  __itoa \
  __memcpy \
  __setjmp \
  div \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

