# libc/z180 Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(srcdir)/../z80-common:$(std_lib_dirs)
AS = $(top_builddir)/bin/sdasz80
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	= crt0.rel
LIB_TYPE	= @LIB_TYPE@
LIB		= z180.lib


PORT_SDCC = $(COMMON_SDCC) \
  crtenter \
  divmixed \
  divsigned \
  _divslonglong \
  _divulonglong \
  divunsigned \
  _modslonglong \
  _modulonglong \
  modunsigned \
  modsigned \
  modmixed \
  mul \
  mulchar \
  _mullonglong \
  __muluint2ulong \
  __mulsint2slong \
  __sdcc_bcall \
  __sdcc_call_hl \
  __sdcc_call_iy \
  __strreverse \
  __uitobcd \
  __ultobcd 

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  heap \
  __itoa \
  __ltoa \
  setjmp \
  _startup \
  div \
  ldiv \
  lldiv \
  vprintf

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

