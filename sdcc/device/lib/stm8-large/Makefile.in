# libc/stm8-large Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH		= $(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasstm8
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	=
LIB_TYPE     = @LIB_TYPE@
LIB = stm8.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  _divschar \
  _divsint \
  _fast_long_neg \
  _modschar \
  _modsint \
  _mulint \
  _mulschar \
  __mulsint2slong \
  __mululonguchar2ulonglong \
  _startup

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  $(COMMON_LIBC_STRUCT_RET) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  heap \
  __itoa \
  __ltoa \
  setjmp

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

