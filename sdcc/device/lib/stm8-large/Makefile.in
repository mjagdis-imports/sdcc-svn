# libc/stm8-large Makefile

srcdir = @srcdir@
top_srcdir      = @top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH		= $(std_lib_dirs)
AS		= $(top_builddir)/bin/sdasstm8
EXTRA_CFLAGS 	= --max-allocs-per-node 25000
PORT_CRT	=
LIB_TYPE     = @LIB_TYPE@
LIB = stm8.lib


PORT_SDCC = \
  _divschar \
  _divsint \
  _divslong \
  _divslonglong \
  _divulong \
  _divulonglong \
  _fast_long_neg \
  _modschar \
  _modsint \
  _modslong \
  _modslonglong \
  _modulong \
  _modulonglong \
  _mulint \
  _mullong \
  _mullonglong \
  _mulschar \
  __mulsint2slong \
  __mulslong2slonglong \
  __mululong2ulonglong \
  __mululonguchar2ulonglong \
  _srulonglong \
  _srslonglong \
  _slulonglong \
  _slslonglong

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  heap \
  __itoa \
  __ltoa \
  setjmp \
  _startup \
  div \
  ldiv \
  lldiv

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

