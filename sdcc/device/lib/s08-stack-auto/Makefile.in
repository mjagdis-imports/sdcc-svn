# libc/s08 Makefile

srcdir 		= @srcdir@
top_srcdir      = @top_srcdir@
top_builddir 	= @top_builddir@
abs_top_builddir = @abs_top_builddir@

include $(srcdir)/../common_files.mk

# user configuration
VPATH  		= $(std_lib_dirs)
AS		= $(top_builddir)/bin/sdas6808
EXTRA_CFLAGS	= --max-allocs-per-node 25000
PORT_CRT	=
LIB_TYPE	= @LIB_TYPE@
LIB 		= s08.lib


PORT_SDCC = $(COMMON_SDCC) \
  $(COMMON_SDCC_LL) \
  $(COMMON_SDCC_LL_SHIFT) \
  _mulint \
  _divsint \
  _divuint \
  _modsint \
  _moduint \
  _ret

PORT_FLOAT = $(COMMON_FLOAT)

PORT_LIBC = $(COMMON_LIBC) \
  atomic_flag_clear \
  atomic_flag_test_and_set \
  __itoa \
  __ltoa \
  __memcpy \
  _heap \
  _startup \
  div \
  ldiv \
  setjmp

PORT_LIBM = $(COMMON_LIBM)

include $(srcdir)/../library_build.mk

