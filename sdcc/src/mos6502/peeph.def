////////////////////////////////////////////////////////
// Dead loads
////////////////////////////////////////////////////////

replace restart {
	lda %1
} by {
	; Peephole dead LA1 - removed dead lda %1
} if notVolatile(%1), notUsed('a' 'z' 'n')

replace restart {
	ldx %1
} by {
	; Peephole dead LX1 - removed dead ldx %1
} if notVolatile(%1), notUsed('x' 'z' 'n')

replace restart {
	ldy %1
} by {
	; Peephole dead LY1 - removed dead ldy %1
} if notVolatile(%1), notUsed('y' 'z' 'n')

replace restart {
	lda %1, %2
} by {
	; Peephole dead LA2 - removed dead lda %1,x
} if notVolatile(%1), notUsed('a' 'z' 'n')

replace restart {
	ldx %1, %2
} by {
	; Peephole dead LX2 - removed dead ldx %1,y
} if notVolatile(%1), notUsed('x' 'z' 'n')

replace restart {
	ldy %1, %2
} by {
	; Peephole dead LY2 - removed dead ldy %1,x
} if notVolatile(%1), notUsed('y' 'z' 'n')

////////////////////////////////////////////////////////
// Dead load/stores
////////////////////////////////////////////////////////

replace restart {
	lda %1
	sta %1
} by {
	; Peephole load/store LSA1 - removed dead lda/sta %1
} if notVolatile(%1), notUsed('a' 'z' 'n')

replace restart {
	ldx %1
	stx %1
} by {
	; Peephole load/store LSX1 - removed dead ldx/stx %1
} if notVolatile(%1), notUsed('x' 'z' 'n')

replace restart {
	ldy %1
	sty %1
} by {
	; Peephole load/store LSY1 - removed dead ldy/sty %1
} if notVolatile(%1), notUsed('y' 'z' 'n')

////////////////////////////////////////////////////////
// Dead transfers - could be merged with dead operations
////////////////////////////////////////////////////////

replace restart {
	%1
} by {
	; Peephole dead transfer TA - removed dead %1
} if same(%1 'txa' 'tya'), notUsed('a' 'z' 'n')

replace restart {
	%1
} by {
	; Peephole dead transfer TX - removed dead %1
} if same(%1 'tax' 'tsx' ), notUsed('x' 'z' 'n')

replace restart {
	tay
} by {
	; Peephole dead transfer TY - removed dead tay
} if notUsed('y' 'z' 'n')

////////////////////////////////////////////////////////
// Dead operations
////////////////////////////////////////////////////////

replace restart {
	%1 %2
} by {
	; Peephole dead logic LOP - removed dead  %1 %2
} if same(%1 'and' 'ora' 'eor'), notUsed('a' 'z' 'n')

replace restart {
	%1 %2
} by {
	; Peephole dead shift SOP - removed dead  %1 a
} if same(%1 'asl' 'lsr' 'rol' 'ror'), same(%2 'a'), notUsed('a' 'z' 'n' 'c')

replace restart {
	%1 %2
} by {
	; Peephole dead arith AOP - removed dead  %1 %2
} if same(%1 'adc' 'sbc'), notUsed('a' 'z' 'n' 'c' 'v')

replace restart {
	%1 %2
} by {
	; Peephole dead arith AOP - removed dead  %1 a
} if same(%1 'inc' 'dec'), same(%2 'a'), notUsed('a' 'z' 'n')

replace restart {
	%1
} by {
	; Peephole dead X op XOP - removed dead  %1
} if same(%1 'inx' 'dex'), notUsed('x' 'z' 'n')

replace restart {
	%1
} by {
	; Peephole dead Y op YOP - removed dead  %1
} if same(%1 'iny' 'dey'), notUsed('y' 'z' 'n')

replace restart {
	%1
} by {
	; Peephole dead carry COP - removed dead  %1
} if same(%1 'clc' 'sec'), notUsed('c')

////////////////////////////////////////////////////////
// Rules for common codegen patterns
////////////////////////////////////////////////////////

// this optimization should be done at the icode level
// last copy should be directly into ret instead of a temp
replace restart {
	sta	%1
	stx	%2
	ldy	#0x00
	sty	%3
	sty	%4
	sty	%6
	lda	%3
	sta	%5
	lda	%1
        rts
} by {
	; Peephole copyret 1 - eliminated useless copy
	ldy	#0x00
	sty	%6
	sty	%5
        rts
}

replace restart {
	sty	%1
	stx	%2
	lda	#0x00
	sta	%3
	sta	%4
	sta	%6
	lda	%3
	sta	%5
	tya
        rts
} by {
	; Peephole copyret 2 - eliminated useless copy
	lda	#0x00
	sta	%6
	sta	%5
	tya
        rts
}

// this should be handled in codegen
// is is generated by: left shift with constant + bit int
replace restart {
	and	#%1
	and	#%2
} by {
	; Peephole dual AND - replaced %1 and %2
        and	#(%1&%2)
}

replace restart {
	sta %1
        %2
	sta %1
} by {
	; Peephole dead sta1 - removed dead sta %1
        %2
	sta %1
} if notVolatile(%1)

replace restart {
	sta %1
        %2 %3
	sta %1
} by {
	; Peephole dead sta2 - removed dead sta %1
        %2 %3
	sta %1
} if notVolatile(%1), notSame(%2 'bne' 'beq' 'bpl' 'bmi' 'bcc' 'bcs' 'bra' 'jsr' 'jmp')

replace restart {
	sta %1,%4
        %2 %3
	sta %1,%4
} by {
	; Peephole dead sta2 - removed dead sta %1,%4
        %2 %3
	sta %1,%4
} if notVolatile(%1), notSame(%2 'bne' 'beq' 'bpl' 'bmi' 'bcc' 'bcs' 'bra' 'jsr' 'jmp')

replace restart {
	ldy #0x01
	dey
} by {
	; Peephole ldy/dey - replaced ldy #0x01
	ldy #0x00
}

replace restart {
	lda	%1
	ldx	%2
	clc
	adc	%3
	sta	%4
	txa
	adc	%5
	sta	%6
} by {
	lda	%1
	; Peephole genpointer XA   - eliminated ldx %2
	clc
	adc	%3
	sta	%4
	lda	%2
	; Peephole genpointer XA   - replaced txa with lda %2
	adc	%5
	sta	%6
} if notUsed('x')

replace restart {
	ldx %2
	lda %1
	clc
	adc %3
	sta %5
	txa
	adc %4
	sta %6
} by {
	; Peephole gen/setPointerGet - removed ldx %2
	lda %1
	clc
	adc %3
	sta %5
	lda %2
	; Peephole gen/setPointerGet   - replaced txa with lda %2
	adc %4
	sta %6
}  if notUsed('x')

replace restart {
        txa
	ldx %1
	sta %2
	txa
	tsx
} by {
	; Peephole genPointerSet 2
	stx %2
        lda %1
        tsx
}

replace restart {
	bne	%1
        txa
%1:
       bne	%2
} by {
	bne	%2
	; Peephole genIfx 1 - skipped chain bne
        txa
%1:
        bne	%2
} if labelInRange(%2), labelRefCountChange(%1 -1), labelRefCountChange(%2 +1)

replace restart {
	bne	%1
        %3	#0x00
%1:
	bne	%2
} by {
	bne	%2
	; Peephole genIfx 1a - skipped chain bne
        %3	#0x00
%1:
        bne	%2
} if same(%3 'cmp' 'cpx' 'cpy'), labelInRange(%2), labelRefCountChange(%1 -1), labelRefCountChange(%2 +1)


replace restart {
	ldx	%1
	lda	%2,%4
	sta	%3
	ldx	%1
	lda	%2,%4
} by {
	; Peephole genPointerSet 3 - removed redundant ldx/lda
	ldx	%1
	lda	%2,%4
	sta	%3
} if notSame(%3 %1)

replace restart {
	ldx %2
	lda %1
        sta %1
        stx %2
} by {
	; Peephole setupDPTR 1 - removed sta/stx
	ldx %2
	lda %1
}

// this rule should be implemented by fusing add/minus followed by assign icode
replace restart {
	pha
	txa
	%1 %2
        tax
	pla
	sta %3
	stx %4
} by {
	; genPlus/Minus 2 - removed pha/pla
	sta %3
	txa
	%1 %2
	sta %4
        tax
	lda %3
} if same(%1 'adc' 'sbc')

// this rule should be implemented by fusing add/minus followed by assign icode
replace restart {
	tay
	txa
	%1 %2
        tax
	tya
	sta %3
	stx %4
        ldy %5
} by {
	; genPlus/Minus 2a - removed tay/tya
	sta %3
	txa
	%1 %2
	sta %4
        tax
	lda %3
        ldy %5
} if same(%1 'adc' 'sbc')

replace restart {
	sty %3
	stx %4
        lda %3
} by {
	sty %3
	stx %4
        tya
	; genPlus/Minus 2c - replaced lda %3 with tya
}

replace restart {
	ldx	%1
	lda	%2
	stx	%3
	lsr	%3
	ror	a
} by {
        ; gen rightshift 1 - changed ldx/stx/lsr to lda/lsr/sta
	lda	%1
	lsr	a
	sta	%3
	lda	%2
	ror	a
}  if notUsed('x')


replace restart {
        ldy %1
	sta %2
	tya
	%3 %4
	tay
} by {
	; Peephole copy/accOp - replaced ldy/tya with lda %1
	sta %2
	lda %1
	%3 %4
	tay
} if same(%3 'and' 'ora' 'eor' 'asl' 'lsr' 'sbc' 'adc' )

replace restart {
        tsx
	lda %1,x
	sta %2,x
	lda %3,x
	sta %4,x
	tsx
} by {
        tsx
	lda %1,x
	sta %2,x
	lda %3,x
	sta %4,x
	; peephole gencopy 1 - removed redundant tsx
}

replace restart {
	lda	%1
	asl	a
	sta	*(REGTEMP+0)
	lda	%2
	rol	a
	tax
	lda	*(REGTEMP+0)
	%5	%3
	sta	%1
	txa
	%5	%4
	sta	%2
} by {
	; peephole lshift1 + logical op - reorder and remove REGTEMP reference
	lda	%1
	asl	a
	%5	%3
	sta	%1
	lda	%2
	rol	a
;	tax
	%5	%4
	sta	%2
} if same(%5 'and' 'ora' 'eor' )

////////////////////////////////////////////////////////
// Reorder copy
////////////////////////////////////////////////////////

replace restart {
	lda %1
	sta %2
	lda %3
	sta %4
        lda %2
} by {
	; Peephole reorder int
	lda %3
	sta %4
	lda %1
	sta %2
}

//replace restart {
//	lda %1
//	sta %2
//	lda %3
//	sta %4
//	lda %5
//	sta %6
//	lda %7
//	sta %8
//	lda %2
//} by {
//	; Peephole reorder long
//	lda %3
//	sta %4
//	lda %5
//	sta %6
//	lda %7
//	sta %8
//	lda %1
//	sta %2
//}


////////////////////////////////////////////////////////
// Remove unnecessary loads
////////////////////////////////////////////////////////

// ora is cheaper than lda (except for lda from immediate, but that can't happen for the two rules below)
replace restart {
        sta	%1
	lda     %1
} by {
        sta	%1
        ora	#0x00
    ; Peephole load 2 - replaced redundant lda by ora
} if notVolatile(%1)

replace restart {
        sta	%1,%2
	lda     %1,%2
} by {
        sta	%1,%2
        ora	#0x00
    ; Peephole load 2a - replaced redundant lda by ora
} if notVolatile(%1)

replace restart {
	stx	%1
	ldx     %1
} by {
	stx	%1
    ; Peephole load 3 - eliminated redundant ldx %1
} if notVolatile(%1), notUsed('n' 'z')

replace restart {
	sty	%1
	ldy     %1
} by {
	sty	%1
    ; Peephole load 4 - eliminated redundant ldy %1
} if notVolatile(%1), notUsed('n' 'z')

replace restart {
	lda     %1
        sta	%3
	lda     %1
} by {
        lda	%1
        sta	%3
    ; Peephole load 5 - removed redundant lda %1
} if notVolatile(%1)


replace restart {
	lda     %1,%2
        sta	%3,%2
	lda     %1,%2
} by {
        lda	%1,%2
        sta	%3,%2
    ; Peephole load 5a - removed redundant lda %1,%2
} if notVolatile(%1)

replace restart {
	ldy	%1
	lda	%1
} by {
	ldy	%1
	; Peephole load 7 - replaced ldy/lda with ldy/tya
	tya
} if notVolatile(%1)

replace restart {
	ldx	%1
	lda	%1
} by {
	ldx	%1
	; Peephole load 7a - replaced ldx/lda with ldx/txa
	txa
} if notVolatile(%1)


////////////////////////////////////////////////////////
// Remove dead register operation/transfers
////////////////////////////////////////////////////////

replace restart {
	tax
	txa
} by {
	tax
	; Peephole regop 7 - removed redundant txa
}

replace restart {
	txa
	tax
} by {
	txa
	; Peephole regop 7a - removed redundant tax
}

replace restart {
	tax
	ldy %1
	txa
} by {
        ldy %1
	tax
	; Peephole regop 7b - removed redundant txa
}

replace restart {
	tay
	tya
} by {
	tay
	; Peephole regop 8 - removed redundant tya preceded by tay
}

replace restart {
	tya
	tay
} by {
	tya
	; Peephole regop 8a - removed redundant tay preceded by tya
}

////////////////////////////////////////////////////////
// load/transfer -> load
///////////////////////////////////////////////////////

replace restart {
	ldy	%2
        tya
} by {
	; Peephole load Y - changed ldy/tya to lda
	lda	%2
} if notUsed('y')

replace restart {
	ldx	%2
        txa
} by {
	; Peephole load X - changed ldx/txa to lda
	lda	%2
} if notUsed('x')

replace restart {
	lda	%2
        tax
} by {
	; Peephole load AX - changed lda/tax to ldx
	ldx	%2
} if notUsed('a')

replace restart {
	lda	%2
        tay
} by {
	; Peephole load AY - changed lda/tya to ldy
	ldy	%2
} if notUsed('a')


////////////////////////////////////////////////////////
// Replace transfer/store with store
////////////////////////////////////////////////////////

replace restart {
	txa
	sta %1
} by {
	; Peephole regop 12 - replaced txa/sta with stx %1
        stx %1
} if notUsed('a' 'n' 'z')

replace restart {
	tya
	sta %1
} by {
	; Peephole regop 12 - replaced tya/sta with sty %1
        sty %1
} if notUsed('a' 'n' 'z')

replace restart {
	tax
	stx %1
} by {
	; Peephole regop 13 - replaced tax/stx with sta %1
        sta %1
} if notUsed('x' 'n' 'z')

replace restart {
	tay
	sty %1
} by {
	; Peephole regop 13 - replaced tay/sty with sta %1
        sta %1
} if notUsed('y' 'n' 'z')

////////////////////////////////////////////////////////
// Remove redundant/unnecessary stack operations
////////////////////////////////////////////////////////

replace restart {
	pla
	pha
} by {
	; Peephole stack 1 - removed dead pla/pha
} if notUsed('a' 'n' 'z')

replace restart {
	pha
	pla
} by {
	; Peephole stack 2a - replaced pha/pla with ora #0x00
	ora #0x00
}

replace restart {
	php
	%1 %2
	plp
} by {
	; Peephole stack 3 - removed useless php/plp around a store
	%1 %2
}  if same(%1 'sta' 'stx' 'sty' )


replace restart {
	php
	plp
} by {
	; Peephole stack 4 - removed dead php/plp
}

////////////////////////////////////////////////////////
// Remove unnecessary ora #00
////////////////////////////////////////////////////////
replace restart {
	ora	#0x00
} by {
	; Peephole or 1 - eliminated unnecessary ora #0x00
} if notUsed('n' 'z')

////////////////////////////////////////////////////////
// Remove unnecessary cmp/cpx/cpy #00
////////////////////////////////////////////////////////

replace restart {
	cmp	#0x00
} by {
	; Peephole or 2 - eliminated unnecessary cmp #0x00
} if notUsed('n' 'z' 'c')

replace restart {
	lda	%1
	cmp	#0x00
} by {
	lda	%1
	; Peephole cmp 1 - eliminated unnecessary cmp #0x00
} if notUsed('c')

replace restart {
	lda	%1,%2
	cmp	#0x00
} by {
	lda	%1,%2
	; Peephole cmp 2 - eliminated unnecessary cmp #0x00
} if notUsed('c')

replace restart {
	%1
	cmp	#0x00
} by {
	%1
	; Peephole cmp 3 - eliminated unnecessary cmp #0x00
} if same(%1 'pla' 'txa' 'tya' ), notUsed('c')

replace restart {
	ldx	%1
	cpx	#0x00
} by {
	ldx	%1
	; Peephole cmp 4 - eliminated unnecessary cpx #0x00
} if notUsed('c')

replace restart {
	ldy	%1
	cpy	#0x00
} by {
	ldy	%1
	; Peephole cmp 5 - eliminated unnecessary cpy #0x00
} if notUsed('c')

replace restart {
	%1
	cpx	#0x00
} by {
	%1
	; Peephole cmp 6 - eliminated unnecessary cpx #0x00
} if same(%1 'inx' 'dex' 'tax' ), notUsed('c')

replace restart {
	%1
	cpy	#0x00
} by {
	%1
	; Peephole cmp 7 - eliminated unnecessary cpy #0x00
} if same(%1 'iny' 'dey' 'tay' ), notUsed('c')

////////////////////////////////////////////////////////
// Remove redundant stores
////////////////////////////////////////////////////////

replace restart {
	lda	%2
	sta	%2
} by {
	lda	%2
	; Peephole store 1 - removed redundant sta %2
} if notVolatile(%2)

replace restart {
	lda	%2,%3
	sta	%2,%3
} by {
	lda	%2,%3
	; Peephole store 1a - removed redundant sta %2,%3
} if notVolatile(%2)

replace restart {
	lda	%2
	%1
	sta	%2
} by {
	lda	%2
	%1
	; Peephole store 2 - removed redundant sta %2
} if notSame(%1 'pla' 'txa' 'tya'), notVolatile(%2)

replace restart {
	ldx	%2
	stx	%2
} by {
	ldx	%2
	; Peephole store 4 - removed redundant stx %2
} if notVolatile(%2)

replace restart {
	ldx	%2
	%1
	stx	%2
} by {
	ldx	%2
	%1
	; Peephole store 5 - removed redundant stx %2
} if notSame(%1 'tax' 'inx' 'dex' 'tsx'), notVolatile(%2)

replace restart {
	ldx	%2
	%1      %3
	stx	%2
} by {
	ldx	%2
	%1      %3
	; Peephole store 5a - removed redundant stx %2
} if notSame(%1 'jsr' 'jmp' 'bne' 'beq' 'bcc' 'bcs' 'bvc' 'bvs' 'bpl' 'bmi' 'bra'), notVolatile(%2)

replace restart {
	ldy	%2
	sty	%2
} by {
	ldy	%2
	; Peephole store 6 - removed redundant sty %2
} if notVolatile(%2)

replace restart {
	ldy	%2
	%1
	sty	%2
} by {
	ldy	%2
	%1
	; Peephole store 7 - removed redundant sty
} if notSame(%1 'tay' 'iny' 'dey'), notVolatile(%2)

replace restart {
	%1	%2
	%1	%2
} by {
	%1	%2
	; Peephole store 8 - removed redundant %1 %2
} if same(%1 'sta' 'stx' 'sty'), notVolatile(%2)

replace restart {
	%1	%2,%3
	%1	%2,%3
} by {
	%1	%2,%3
	; Peephole store 8a - removed redundant %1 %2,%3
} if same(%1 'sta' 'stx' 'sty'), notVolatile(%2)

////////////////////////////////////////////////////////
// Remove duplicate branches
////////////////////////////////////////////////////////

replace restart {
	%1	%2
	%1	%2
} by {
	%1	%2
	; Peephole dup branch 1 - removed %1
} if same(%1 'bne' 'beq' 'bcc' 'bcs' 'bvc' 'bvs' 'bpl' 'bmi' 'bra' 'jmp'), labelRefCountChange(%2 -1)


////////////////////////////////////////////////////////
// Replace jmp with branch
////////////////////////////////////////////////////////

replace restart {
	bne	%1
	jmp	%5
%1:
} by {
	beq	%5
	; Peephole branch 1 - inverted bne and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	beq	%1
	jmp	%5
%1:
} by {
	bne	%5
	; Peephole branch 2 - inverted beq and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bcc	%1
	jmp	%5
%1:
} by {
	bcs	%5
	; Peephole branch 3 - inverted bcc and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bcs	%1
	jmp	%5
%1:
} by {
	bcc	%5
	; Peephole branch 4 - inverted bcs and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bpl	%1
	jmp	%5
%1:
} by {
	bmi	%5
	; Peephole branch 5 - inverted bpl and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bmi	%1
	jmp	%5
%1:
} by {
	bpl	%5
	; Peephole branch 6 - inverted bmi and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bvc	%1
	jmp	%5
%1:
} by {
	bvs	%5
	; Peephole branch 7 - inverted bvc and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

replace restart {
	bvs	%1
	jmp	%5
%1:
} by {
	bvc	%5
	; Peephole branch 8 - inverted bvs and eliminated jmp
%1:
} if labelInRange(%5), labelRefCountChange(%1 -1)

////////////////////////////////////////////////////////
// Replace branch to jmp with branch
////////////////////////////////////////////////////////

replace restart {
	%1	%5
} by {
	; Peephole branch 9 - replaced branch to jmp with branch
	%1	%6
} if same(%1 'bne' 'beq' 'bcc' 'bcs' 'bvc' 'bvs' 'bpl' 'bmi'), labelIsUncondJump(%5), notSame(%5 %6), labelInRange(%6), labelRefCountChange(%5 -1), labelRefCountChange(%6 +1)

replace restart {
	jmp	%5
} by {
	; Peephole branch 10 - replaced jmp to jmp with jmp
	jmp	%6
} if labelIsUncondJump(%5), notSame(%5 %6), labelRefCountChange(%5 -1), labelRefCountChange(%6 +1)

replace restart {
	jmp	%5
} by {
	; Peephole branch 11 - replaced jmp to rts with rts
	rts
} if optimizeReturn(), labelIsReturnOnly(%5), labelRefCountChange(%5 -1)

////////////////////////////////////////////////////////
// Remove dead code
////////////////////////////////////////////////////////

replace restart {
        %1	%2
        %3	%4
%2:
} by {
        ; Peephole dead 1 - eliminated %1 and dead %3
%2:
} if same(%1 'jmp' 'bra'), labelRefCountChange(%2 -1)


////////////////////////////////////////////////////////
// Remove branch/jump to following label
////////////////////////////////////////////////////////

replace restart {
        %1	%2
%2:
} by {
        ; Peephole branch 12 - eliminated branch to %2
%2:
} if same(%1 'bne' 'beq' 'bcc' 'bcs' 'bvc' 'bvs' 'bpl' 'bmi' 'bra' 'jmp'), labelRefCountChange(%2 -1)

////////////////////////////////////////////////////////
// Tail call optimization
////////////////////////////////////////////////////////

replace restart {
	rts
%1:
	rts
} by {
    ; Peephole ret 1 - eliminated redundant rts
%1:
	rts
}

replace restart {
	jsr	%1
	rts
} by {
	jmp	%1
	; Peephole ret 2 - tail call optimization.
} if optimizeReturn()

////////////////////////////////////////////////////////
// Unused label removal
////////////////////////////////////////////////////////

// should be one of the last peepholes
replace restart {
%1:
} by {
	; Peephole label - removed redundant label %1
} if labelRefCount(%1 0)

